# =============================================================================
# holtec-training website-client — environment variable template
# =============================================================================
# Copy this file to `.env` for local development. Set the same values on Netlify
# (Site → Site configuration → Environment variables) for the live environment.
#
# Legend:
#   [REQUIRED]  — must be set for the app to function
#   [OPTIONAL]  — has a sensible default or is only needed for a specific flow
#   [SECURITY]  — activates a security layer; skip on local dev, set in the live environment
#
# Prefixes:
#   VITE_*  = exposed to the browser bundle (safe: publishable keys, IDs).
#             NEVER prefix a secret with VITE_ — it will leak to every visitor.
#   All other = server-side only (Netlify Functions).
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# Sanity CMS
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Browser-side reads (programs list, quiz questions, siteConfig)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=

# [REQUIRED] Server-side reads inside Netlify Functions
SANITY_PROJECT_ID=
SANITY_DATASET=


# ─────────────────────────────────────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Server-side Stripe API access
# Test mode: sk_test_...  |  Live mode: sk_live_...
STRIPE_SECRET_KEY=

# [REQUIRED] Verifies Stripe webhook signatures on stripe-webhook.ts
# Test mode: use `stripe listen`'s issued whsec_...
# Live mode: from Stripe Dashboard → Developers → Webhooks → your endpoint
STRIPE_WEBHOOK_SIGNING_SECRET=

# [REQUIRED] Browser-side Stripe.js loader (embedded Checkout iframe)
# Publishable keys are safe to expose. VITE_ prefix required for Vite to bundle.
# Test: pk_test_...  |  Live: pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Site base URL
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Absolute origin of the site. Used to construct:
#   - Stripe Checkout return_url  ${HOLTEC_ENDPOINT}/programs/thanks?cs=...
#   - Stripe Portal return_url    ${HOLTEC_ENDPOINT}/programs  (fallback path)
# Local dev:      http://localhost:8888
# Live site:      https://holtectraining.co.nz
HOLTEC_ENDPOINT=http://localhost:8888


# ─────────────────────────────────────────────────────────────────────────────
# n8n webhook pairs — every workflow gets its own URL + distinct SECRET
# ─────────────────────────────────────────────────────────────────────────────
# The URL points at the n8n webhook on cluster01.
# The SECRET must match the header-auth credential value on cluster01
#   (n8n sends 401 if the X-Program-Portal-Secret header doesn't match).
# Distinct secrets per endpoint means rotating one doesn't force the others.

# [REQUIRED] Main-site contact form
N8N_CONTACT_URL=
N8N_CONTACT_SECRET=

# [REQUIRED] Program Portal — Path A free-PDF fulfilment
N8N_FREE_SELECTION_URL=
N8N_FREE_SELECTION_SECRET=

# [REQUIRED] Program Portal — Path B subscription-created (fires from stripe-webhook.ts)
N8N_SUBSCRIPTION_CREATED_URL=
N8N_SUBSCRIPTION_CREATED_SECRET=

# [REQUIRED] Program Portal — funnel-event logging
N8N_FUNNEL_EVENT_URL=
N8N_FUNNEL_EVENT_SECRET=

# [REQUIRED] Program Portal — ContactStep email pre-check (Layer 1 dedup)
N8N_CHECK_EMAIL_URL=
N8N_CHECK_EMAIL_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
# Stripe Customer Portal (server-to-server, called by subscription-created workflow)
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Shared secret for calls to create-portal-session.ts.
# MUST match the value on cluster01 (subscription-created workflow uses it to
# call this Function). Rotate them in lock-step.
# Generate: `openssl rand -hex 32`
PORTAL_SESSION_SHARED_SECRET=

# [OPTIONAL] Explicit override for where Stripe sends the customer after they
# finish in the Portal. If unset, falls back to `${HOLTEC_ENDPOINT}/programs`.
# PROGRAM_PORTAL_RETURN_URL=https://holtectraining.co.nz/programs


# ─────────────────────────────────────────────────────────────────────────────
# Feature flags
# ─────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Set to `false` to skip the ContactStep email pre-check locally.
# Default (unset or `true`): pre-check enabled.
VITE_CHECK_EMAIL_ENABLED=


# ─────────────────────────────────────────────────────────────────────────────
# SECURITY LAYERS (all three are opt-in — enable when ready)
# ─────────────────────────────────────────────────────────────────────────────
# Each layer is independently gated by its env vars. If unset, the layer skips
# silently — so local dev and tests work without any of these configured.
# See netlify/functions/_lib/README.md and SECURITY.md for the full pattern.

# [SECURITY] Layer 1 — Origin check
# Comma-separated allow-list of origins that may call the browser-facing Functions.
# Single wildcards supported for Netlify preview URLs.
# Skip in local dev (NETLIFY_DEV=true bypasses).
# NETLIFY_ALLOWED_ORIGINS=https://holtectraining.co.nz,https://deploy-preview-*.netlify.app,https://holtectraining.netlify.app/

# [SECURITY] Layer 2 — Rate limit (Upstash Redis)
# Sign up at upstash.com (free tier is enough), create a Redis DB, copy both.
# Rate-limit budgets are set per-Function in code (see _lib/README.md).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# [SECURITY] Layer 3 — Cloudflare Turnstile
# Sign up at cloudflare.com → Turnstile → add site → copy both keys.
# Site key is public (browser); Secret key is server-side.
# When set, Functions marked `requireTurnstile: true` will demand a token.
# TURNSTILE_SECRET_KEY=
# VITE_TURNSTILE_SITE_KEY=


# ─────────────────────────────────────────────────────────────────────────────
# Netlify Secrets Scanning
# ─────────────────────────────────────────────────────────────────────────────
# Netlify blocks deploys if it finds any of your env-var VALUES in the built
# output. Common false positive: env vars whose value is a common word like
# "production" or your Sanity project ID (which appears in the built bundle
# because it's needed at browser load). Add such vars to the omit list:
#
# SECRETS_SCAN_OMIT_KEYS=VITE_SANITY_PROJECT_ID,VITE_SANITY_DATASET,SANITY_DATASET
#
# Alternative — disable scanning entirely (only if you're sure no real secrets
# ever land in the bundle):
# SECRETS_SCAN_ENABLED=false
#
# See netlify.toml for the current setting.


# ─────────────────────────────────────────────────────────────────────────────
# Auto-set by tooling — do NOT set manually
# ─────────────────────────────────────────────────────────────────────────────
# NETLIFY_DEV=true          # set automatically by `netlify dev` — bypasses origin check
