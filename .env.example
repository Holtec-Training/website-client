# Template for local development. Copy to .env and fill in.
# See README for what each value is used for.

# --- Browser (Vite) ---
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=

# --- Netlify Function runtime ---
SANITY_PROJECT_ID=
SANITY_DATASET=

# --- Contact form Function ---
N8N_CONTACT_URL=
N8N_CONTACT_SECRET=

# --- Stripe (test-mode) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SIGNING_SECRET=
# Publishable key is browser-side (embedded Checkout iframe loader).
# Vite requires the VITE_ prefix to expose it in the bundle. Publishable keys are safe to expose by design.
VITE_STRIPE_PUBLISHABLE_KEY=

# --- n8n webhook pairs (URL + distinct SECRET each) ---
N8N_FREE_SELECTION_URL=
N8N_FREE_SELECTION_SECRET=

N8N_SUBSCRIPTION_CREATED_URL=
N8N_SUBSCRIPTION_CREATED_SECRET=

N8N_FUNNEL_EVENT_URL=
N8N_FUNNEL_EVENT_SECRET=

N8N_CHECK_EMAIL_URL=
N8N_CHECK_EMAIL_SECRET=

# --- Feature flags ---
# Set VITE_CHECK_EMAIL_ENABLED=false to skip the ContactStep email pre-check locally.
# Leave blank / unset in production (defaults to enabled).
VITE_CHECK_EMAIL_ENABLED=

# --- Stripe Customer Portal (server-to-server, called by n8n) ---
PORTAL_SESSION_SHARED_SECRET=
PROGRAM_PORTAL_RETURN_URL=https://holtectraining.co.nz/programs

# --- Checkout return URL base (create-checkout-session Function appends /programs/thanks?cs=...)
# Local dev: http://localhost:8888 — Stripe redirects to your dev server after payment
# Netlify preview: set to the preview URL (e.g. https://deploy-preview-1--holtec.netlify.app)
# Production: https://holtectraining.co.nz
CHECKOUT_RETURN_URL_BASE=
